#!/usr/bin/python3
"""Cinnamon native Uninstall menu handler for pacman-based systems.

Based on the Linux Mint implementation and original Arch port by Giulio Girardi.
SPDX-License-Identifier: GPL-2.0-or-later
"""
import gettext
import subprocess
import sys
import threading

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk

sys.path.insert(0, "/usr/lib/cinnamon-remove-application")
from operations import (RemovalError, validate_launcher, package_owner,
                        removal_plan, protected_in, removal_command,
                        flatpak_target, flatpak_removal_command,
                        unowned_launcher_command)

gettext.install("mint-common", "/usr/share/linuxmint/locale")


# Cinnamon 6.8 has a separate St/CSS theme for shell dialogs. A standalone
# GTK 3 client cannot inherit that theme, so use a small scoped GTK stylesheet.
# The palette follows the shipped Cinnamon shell; dark/light preference comes
# from Cinnamon's own appearance setting rather than the shell theme.
_CSS_PROVIDER = None
_THEME_SETTINGS = []
_DARK_STYLE = {
    "surface": "#242428",
    "text": "#ffffff",
    "border": "#333337",
    "button": "#39393c",
    "button_hover": "#454549",
    "list": "#303034",
    "accent": "#3584e4",
    "destructive": "#c01c28",
    "destructive_hover": "#d12c37",
}
_LIGHT_STYLE = {
    "surface": "#ededef",
    "text": "#242428",
    "border": "#b8b8be",
    "button": "#d2d2d6",
    "button_hover": "#bcbcc2",
    "list": "#ffffff",
    "accent": "#3584e4",
    "destructive": "#c01c28",
    "destructive_hover": "#dc3542",
}


def _get_settings(schema_id):
    try:
        source = Gio.SettingsSchemaSource.get_default()
        if source is not None and source.lookup(schema_id, True):
            return Gio.Settings.new(schema_id)
    except (AttributeError, GLib.Error):
        pass
    return None


def _is_dark():
    # 0: no preference, 1: dark, 2: light (Cinnamon's cs_themes.py).
    portal = _get_settings("org.x.apps.portal")
    if portal is not None:
        value = portal.get_enum("color-scheme")
        if value in (1, 2):
            return value == 1
    # 'Mixed' mode: follow the active GTK theme, not Cinnamon's St theme.
    interface = _get_settings("org.cinnamon.desktop.interface")
    if interface is not None:
        name = interface.get_string("gtk-theme")
    else:
        name = Gtk.Settings.get_default().get_property("gtk-theme-name")
    return "dark" in (name or "").lower()


def _update_dialog_css(*_unused):
    if _CSS_PROVIDER is None:
        return
    colors = _DARK_STYLE if _is_dark() else _LIGHT_STYLE
    css = r"""
    window.cinnamon-remove-dialog {
        background-color: %(surface)s;
        color: %(text)s;
        border: 1px solid %(border)s;
        border-radius: 18px;
    }
    window.cinnamon-remove-dialog .dialog-vbox,
    window.cinnamon-remove-dialog .dialog-action-area,
    window.cinnamon-remove-dialog box {
        background-color: transparent;
    }
    window.cinnamon-remove-dialog label {
        color: %(text)s;
    }
    window.cinnamon-remove-dialog button {
        background-image: none;
        box-shadow: none;
        background-color: %(button)s;
        border: 1px solid %(border)s;
        border-radius: 10px;
        color: %(text)s;
        min-height: 30px;
        min-width: 110px;
        padding: 5px 14px;
        font-weight: bold;
    }
    window.cinnamon-remove-dialog button:hover {
        background-color: %(button_hover)s;
    }
    window.cinnamon-remove-dialog button.destructive-action {
        background-color: %(destructive)s;
        color: white;
    }
    window.cinnamon-remove-dialog button.destructive-action:hover {
        background-color: %(destructive_hover)s;
    }
    window.cinnamon-remove-dialog scrolledwindow,
    window.cinnamon-remove-dialog treeview.view {
        background-color: %(list)s;
        color: %(text)s;
        border-radius: 8px;
    }
    window.cinnamon-remove-dialog treeview.view:selected {
        background-color: %(accent)s;
        color: white;
    }
    """ % colors
    _CSS_PROVIDER.load_from_data(css.encode("utf-8"))


def _style_dialog(dialog, destructive_response=None):
    global _CSS_PROVIDER
    dialog.get_style_context().add_class("cinnamon-remove-dialog")
    dialog.set_decorated(False)
    dialog.set_position(Gtk.WindowPosition.CENTER)
    dialog.set_border_width(16)
    dialog.set_keep_above(True)
    # Transparent visual permits rounded outer corners on compositors that
    # support RGBA GTK windows; the CSS background remains fully opaque.
    screen = dialog.get_screen()
    if screen is not None and screen.get_rgba_visual() is not None:
        dialog.set_visual(screen.get_rgba_visual())
        dialog.set_app_paintable(True)
    if destructive_response is not None:
        button = dialog.get_widget_for_response(destructive_response)
        if button is not None:
            button.get_style_context().add_class("destructive-action")
    if _CSS_PROVIDER is None:
        _CSS_PROVIDER = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), _CSS_PROVIDER,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        # Refresh existing dialogs when appearance changes.
        for schema, key in [
            ("org.x.apps.portal", "color-scheme"),
            ("org.cinnamon.desktop.interface", "gtk-theme"),
        ]:
            settings = _get_settings(schema)
            if settings is not None:
                settings.connect("changed::" + key, _update_dialog_css)
                _THEME_SETTINGS.append(settings)
        Gtk.Settings.get_default().connect(
            "notify::gtk-theme-name", _update_dialog_css)
    _update_dialog_css()



def message(text, kind=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.CLOSE, detail=None):
    dlg = Gtk.MessageDialog(parent=None, flags=Gtk.DialogFlags.MODAL,
                            message_type=kind, buttons=buttons, text=text)
    _style_dialog(dlg, Gtk.ResponseType.YES if buttons == Gtk.ButtonsType.YES_NO else
                  Gtk.ResponseType.OK if buttons == Gtk.ButtonsType.OK_CANCEL else None)
    if detail:
        dlg.format_secondary_text(detail)
    response = dlg.run()
    dlg.destroy()
    return response


def approve_packages(packages):
    dlg = Gtk.MessageDialog(parent=None, flags=Gtk.DialogFlags.MODAL,
                            message_type=Gtk.MessageType.WARNING,
                            buttons=Gtk.ButtonsType.OK_CANCEL,
                            text=_("The following packages will be removed:"))
    _style_dialog(dlg, Gtk.ResponseType.OK)
    model = Gtk.ListStore(str)
    for package in packages:
        model.append([package])
    view = Gtk.TreeView(model=model)
    view.append_column(Gtk.TreeViewColumn(_("Packages to be removed"),
                                          Gtk.CellRendererText(), text=0))
    scroll = Gtk.ScrolledWindow()
    scroll.set_size_request(340, 180)
    scroll.add(view)
    dlg.get_content_area().add(scroll)
    dlg.show_all()
    approved = dlg.run() == Gtk.ResponseType.OK
    dlg.destroy()
    return approved


def perform(command):
    """Leave GTK responsive while polkit and pacman run."""
    dlg = Gtk.Dialog(title=_("Removing application"), parent=None,
                     flags=Gtk.DialogFlags.MODAL)
    _style_dialog(dlg)
    dlg.set_deletable(False)
    row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
    spinner = Gtk.Spinner()
    spinner.start()
    row.pack_start(spinner, False, False, 0)
    row.pack_start(Gtk.Label(label=_("Removing application…")), True, True, 0)
    dlg.get_content_area().add(row)
    result = {}

    def worker():
        try:
            result["process"] = subprocess.run(
                command, text=True, stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT, check=False)
        except OSError as exc:
            result["error"] = str(exc)
        GLib.idle_add(dlg.response, Gtk.ResponseType.OK)

    dlg.show_all()
    threading.Thread(target=worker, daemon=True).start()
    dlg.run()
    spinner.stop()
    dlg.destroy()
    if "error" in result:
        message(_("Could not start removal."), detail=result["error"])
        return False
    process = result.get("process")
    if process is None or process.returncode != 0:
        output = process.stdout if process else ""
        message(_("Failed to remove application."),
                detail=(output or _("Authentication cancelled or removal failed."))[-5000:])
        return False
    return True


def main(path):
    path = validate_launcher(path)
    package = package_owner(path)
    if package:
        packages = removal_plan(package)
        blocked = protected_in(packages)
        if blocked:
            message(_("Cannot remove package %s as it is required by a system package.") % package,
                    detail=", ".join(blocked))
            return 1
        if not approve_packages(packages):
            return 0
        return 0 if perform(removal_command(packages)) else 1

    flatpak = flatpak_target(path)
    if flatpak:
        name, scope = flatpak
        answer = message(_("Uninstall Flatpak application %s?") % name,
                         Gtk.MessageType.QUESTION, Gtk.ButtonsType.OK_CANCEL,
                         _("Installation: %s") % scope[2:])
        if answer != Gtk.ResponseType.OK:
            return 0
        return 0 if perform(flatpak_removal_command(name, scope)) else 1

    answer = message(
        _("This menu item is not associated to any package. "
          "Do you want to remove it from the menu anyway?"),
        Gtk.MessageType.WARNING, Gtk.ButtonsType.YES_NO, path)
    if answer != Gtk.ResponseType.YES:
        return 0
    return 0 if perform(unowned_launcher_command(path)) else 1


if __name__ == "__main__":
    if len(sys.argv) != 2:
        print("Usage: cinnamon-remove-application FILE.desktop", file=sys.stderr)
        sys.exit(2)
    try:
        sys.exit(main(sys.argv[1]))
    except (OSError, RemovalError) as exc:
        message(_("Cannot remove application."), detail=str(exc))
        sys.exit(1)

